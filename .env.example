# 复制成 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，绝不要提交

APP_ENV=local
LOG_LEVEL=INFO

# 阶段 0 暂时用不到，阶段 0 后半段接 PostgreSQL 时再填
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb

# 阶段 1：Anthropic API Key，去 console.anthropic.com 创建
ANTHROPIC_API_KEY=
# 改这一行就能换模型：claude-haiku-5-5 / claude-sonnet-5-5 / claude-opus-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# 第二家厂商（阶段 1 后半段，用来逼出接口抽象）
DEEPSEEK_API_KEY=
